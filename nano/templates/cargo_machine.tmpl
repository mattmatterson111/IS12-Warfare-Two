<div style="background:#000000;color:#FFFFFF;padding:20px;font-family:monospace;">
	<div style="border-bottom:2px solid {{:data.accent}};padding-bottom:16px;margin-bottom:20px;">
		<div style="font-size:11px;letter-spacing:2px;color:#788589;">FIELD LOGISTICS NETWORK</div>
		<div style="font-size:20px;font-weight:bold;color:#d5dbdd;">{{:data.machine_name}}</div>
		<div style="font-size:11px;color:#788589;">SECURE SUPPLY TERMINAL // AUTHORIZED PERSONNEL ONLY</div>
	</div>

	<div style="background:#2b2b2b;border:1px solid #788589;padding:8px;margin-bottom:10px;">
		<div style="color:#788589;font-size:11px;">FACTION ACCOUNT</div>
		<div style="font-size:20px;color:#c4a758;">{{:data.balance}} CREDITS</div>
		<div style="margin-top:5px;">LINKED CARGO PADS: {{:data.pad_count}}</div>
		<div>
			{{:helper.link('RE-ESTABLISH LINK', 'refresh', {'action' : 'reconnect'}, data.useable ? null : 'disabled')}}
		</div>
		<div style="clear:both;"></div>
	</div>

	<div style="clear:both;color:{{:data.status_error ? '#ffd04d' : '#44ff4d'}};margin:8px 0 10px;">
		SYSTEM STATUS: {{:data.status_message}}
	</div>

	<div style="font-size:15px;font-weight:bold;color:#d5dbdd;border-bottom:1px solid #303a3e;padding-bottom:5px;margin-bottom:8px;">
		AVAILABLE SUPPLIES
	</div>
	{{for data.categories :category:category_index}}
		<div style="background:#2b2b2b;border:1px solid;padding:7px;margin:8px 0 4px;color:{{:data.accent}};font-weight:bold;">
			{{:category.name}}
		</div>
		{{if category.name == 'Artillery'}}
			<div style="padding:6px 8px 10px;">
				<div>Coordinate-targeted artillery barrage</div>
				<div style="color:#858f93;">Cost: {{:data.artillery_cost}} credits</div>
				{{:helper.link('AUTHORIZE ARTILLERY STRIKE', 'warning', {'action' : 'artillery'}, data.useable && data.pad_count > 0 && data.balance >= data.artillery_cost ? null : 'disabled')}}
			</div>
		{{else}}
			{{for category.products :product:product_index}}
				<div style="border-bottom:1px solid #282f33;padding:6px 4px;">
					<span>{{:product.name}}</span>
					<span style="color:#c4a758;"> {{:product.price}} cr.</span>
					{{:helper.link('ORDER', 'cart', {'action' : 'purchase', 'product' : product.index}, data.useable && data.pad_count > 0 && data.balance >= product.price ? null : 'disabled')}}
				</div>
			{{empty}}
				<div style="padding:6px 8px;color:#788589;">No supplies are currently listed in this category.</div>
			{{/for}}
		{{/if}}
	{{/for}}
</div>
